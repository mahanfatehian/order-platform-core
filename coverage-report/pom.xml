<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.orderprocessing</groupId>
        <artifactId>order-processing-platform</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>coverage-report</artifactId>
    <packaging>pom</packaging>
    <description>Merges every module's JaCoCo results into one report. It ships no code of its own.</description>

    <!-- Depending on every module places this one last in the reactor and tells report-aggregate what to merge. -->
    <dependencies>
        <dependency>
            <groupId>com.orderprocessing</groupId>
            <artifactId>security-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.orderprocessing</groupId>
            <artifactId>kafka-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.orderprocessing</groupId>
            <artifactId>user-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.orderprocessing</groupId>
            <artifactId>auth-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.orderprocessing</groupId>
            <artifactId>store-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.orderprocessing</groupId>
            <artifactId>order-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.orderprocessing</groupId>
            <artifactId>discovery-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.orderprocessing</groupId>
            <artifactId>gateway-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.orderprocessing</groupId>
            <artifactId>web-ui-service</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>aggregate-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

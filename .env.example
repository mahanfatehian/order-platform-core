# ==========================================
# Local development configuration
# Copy this file to .env before starting Compose. Every value labelled
# local-development-only must be replaced outside a developer workstation.
# ==========================================
SPRING_PROFILES_ACTIVE=dev

# ==========================================
# Database Configuration
# ==========================================
DB_NAME=userdb
DB_USERNAME=order_app
# Local development only. Replace in every shared or production environment.
DB_PASSWORD=local-dev-only-database-password

# ==========================================
# Redis Configuration
# ==========================================
# Local development only. Redis authentication is enabled by Compose.
REDIS_PASSWORD=local-dev-only-redis-password

# ==========================================
# Optional inspection-tool host ports
# ==========================================
# Optional `tools` profile (Kafka topic/event browser).
KAFKA_UI_PORT=8090
# Optional `observability` profile.
PROMETHEUS_PORT=9090

# ==========================================
# Service Ports (Local Development)
# ==========================================
AUTH_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
STORE_SERVICE_PORT=8083
ORDER_SERVICE_PORT=8084
WEB_UI_SERVICE_PORT=8085
GATEWAY_SERVICE_PORT=8080
DISCOVERY_SERVICE_PORT=8761

# ==========================================
# JWT signing (local development only)
# Use a randomly generated value of at least 64 characters outside local dev.
# ==========================================
JWT_SECRET=local-dev-only-jwt-signing-key-change-me-0123456789-abcdefghijklmnopqrstuvwxyz

# ==========================================
# Internal Service API Keys
# (Must match between caller and callee)
# ==========================================
USER_SERVICE_INTERNAL_API_KEY=local-dev-only-user-service-api-key-change-me
STORE_SERVICE_INTERNAL_API_KEY=local-dev-only-store-service-api-key-change-me

# Browser session cookie. Set true behind HTTPS in production.
SESSION_COOKIE_SECURE=false

# The gateway is the only port published to the host and normally has nothing in front of it, so it ignores
# X-Forwarded-* and Forwarded from callers and strips them before routing. Set to "framework" ONLY when a
# trusted load balancer terminates in front of it, otherwise any client can choose its own rate-limit bucket.
GATEWAY_FORWARD_HEADERS_STRATEGY=none
# How long the edge waits on a downstream that has accepted the connection but not answered. Unset means
# forever, which lets one stalled service exhaust the shared connection pool and stall unrelated routes.
GATEWAY_RESPONSE_TIMEOUT=30s
GATEWAY_CONNECT_TIMEOUT_MS=2000

# Local UI behavior
THYMELEAF_CACHE=false
# Distinct products one cart may hold. store-service refuses to price a quote carrying more than 100, so a
# larger cart could never be rendered; keep this at or below that.
CART_MAXIMUM_LINE_ITEMS=100
REGISTRATION_ENABLED=true
# Shows local-only persona credentials on the sign-in page.
DEMO_MODE=true

# Sign-in captcha. The challenge is rendered in-process, so no keys or outbound
# network access are required. Counters are held in Redis and slide with activity.
CAPTCHA_ENABLED=true
# Failed sign-ins tolerated from one address, or against one account, before a captcha appears.
CAPTCHA_FAILURE_THRESHOLD=3
# Registration submissions tolerated from one address before a captcha appears.
CAPTCHA_REGISTRATION_THRESHOLD=3
# How long attempt counters survive without further activity.
CAPTCHA_WINDOW=15m
# How long an issued challenge stays solvable.
CAPTCHA_TTL=2m

# Request ceilings for the endpoints an anonymous caller can reach directly on the UI.
# The gateway limiter only covers /api/**, so these routes would otherwise be unmetered.
RATE_LIMIT_ENABLED=true
# Sign-in and registration submissions allowed from one address per window, whatever the outcome.
RATE_LIMIT_SUBMISSIONS_PER_WINDOW=10
# Captcha images allowed from one address per window.
RATE_LIMIT_CHALLENGES_PER_WINDOW=30
RATE_LIMIT_WINDOW=1m

# ==========================================
# Diagnostic log levels
# Every service ships at INFO. Raise one of these to DEBUG only while
# reproducing a problem, and never leave them raised in a shared
# environment: SQL logging prints every statement a service executes and
# security logging prints filter-chain and token details.
# ==========================================
LOG_LEVEL_SQL=INFO
LOG_LEVEL_SECURITY=INFO
LOG_LEVEL_FLYWAY=INFO
LOG_LEVEL_GATEWAY=INFO
LOG_LEVEL_INTERNAL_CLIENT=INFO

# ==========================================
# Event delivery and reconciliation tuning
# ==========================================
ORDER_PENDING_TIMEOUT=PT10M
ORDER_OUTBOX_MAX_ATTEMPTS=5
ORDER_OUTBOX_RETRY_BASE_DELAY=1000
ORDER_OUTBOX_RETRY_MAX_DELAY=60000
ORDER_OUTBOX_RETENTION=P30D
ORDER_INBOX_RETENTION=P30D
STORE_OUTBOX_MAX_ATTEMPTS=5
STORE_OUTBOX_RETRY_BASE_DELAY=1000
STORE_OUTBOX_RETRY_MAX_DELAY=60000
STORE_OUTBOX_RETENTION=P30D
STORE_INBOX_RETENTION=P30D
